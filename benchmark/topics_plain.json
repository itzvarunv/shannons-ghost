[
  {"id": "msd", "title": "Mass-spring-damper", "field": "mechanics", "kind": "ode", "independent": ["t"], "dependent": ["x"], "params": ["m", "c", "k", "F"], "equation": "m*D(x, t, 2) + c*D(x, t, 1) + k*x = F"},
  {"id": "rlc", "title": "Series RLC circuit", "field": "electrical", "kind": "ode", "independent": ["t"], "dependent": ["q"], "params": ["L", "R", "C", "V"], "equation": "L*D(q, t, 2) + R*D(q, t, 1) + q/C = V"},
  {"id": "heat", "title": "Heat conduction in a rod", "field": "thermal", "kind": "pde", "independent": ["t", "x"], "dependent": ["u"], "params": ["alpha"], "equation": "D(u, t, 1) = alpha*D(u, x, 2)"},
  {"id": "diffusion", "title": "Particle diffusion (Fick's second law)", "field": "chemistry", "kind": "pde", "independent": ["t", "x"], "dependent": ["n"], "params": ["Dm"], "equation": "D(n, t, 1) = Dm*D(n, x, 2)"},
  {"id": "boolean", "title": "Boolean algebra expression", "field": "mathematics", "kind": "logic", "variables": ["x", "y", "z"], "semantics": {}, "equation": "x & (y | z)"},
  {"id": "relay", "title": "Relay switching network", "field": "electrical", "kind": "logic", "variables": ["a", "b", "c"], "semantics": {"series": "And", "parallel": "Or"}, "equation": "series(a, parallel(b, c))"},
  {"id": "spring_energy", "title": "Energy stored in a spring", "field": "mechanics", "kind": "algebraic", "dependent": ["U", "x"], "params": ["k"], "equation": "U = k*x**2/2"},
  {"id": "capacitor_energy", "title": "Energy stored in a capacitor", "field": "electrical", "kind": "algebraic", "dependent": ["W", "V"], "params": ["C"], "equation": "W = C*V**2/2"},
  {"id": "pipe", "title": "Laminar pipe flow", "field": "fluids", "kind": "algebraic", "dependent": ["Qf", "dP"], "params": ["Rh"], "equation": "Qf = dP/Rh"},
  {"id": "ohm", "title": "Ohm's law", "field": "electrical", "kind": "algebraic", "dependent": ["I", "V"], "params": ["R"], "equation": "I = V/R"},
  {"id": "truss_node", "title": "Force balance at a truss joint", "field": "structures", "kind": "algebraic", "dependent": ["F1", "F2", "P"], "params": [], "equation": "F1 + F2 = P"},
  {"id": "kcl", "title": "Kirchhoff's current law at a node", "field": "electrical", "kind": "algebraic", "dependent": ["I1", "I2", "Is"], "params": [], "equation": "I1 + I2 = Is"},
  {"id": "decay", "title": "Radioactive decay", "field": "nuclear", "kind": "ode", "independent": ["t"], "dependent": ["N"], "params": ["lam"], "equation": "D(N, t, 1) = -lam*N"},
  {"id": "rc", "title": "RC discharge", "field": "electrical", "kind": "ode", "independent": ["t"], "dependent": ["Q"], "params": ["R", "C"], "equation": "D(Q, t, 1) = -Q/(R*C)"},
  {"id": "pendulum_small", "title": "Pendulum, small angle", "field": "mechanics", "kind": "ode", "independent": ["t"], "dependent": ["th"], "params": ["g", "l"], "equation": "D(th, t, 2) + (g/l)*th = 0"},
  {"id": "lc", "title": "LC oscillator", "field": "electrical", "kind": "ode", "independent": ["t"], "dependent": ["q"], "params": ["L", "C"], "equation": "D(q, t, 2) + q/(L*C) = 0"},
  {"id": "quad_drag", "title": "Falling body with quadratic drag", "field": "fluids", "kind": "ode", "independent": ["t"], "dependent": ["v"], "params": ["m", "c", "g"], "equation": "m*D(v, t, 1) + c*v**2 = m*g"},
  {"id": "logistic", "title": "Logistic population growth", "field": "ecology", "kind": "ode", "independent": ["t"], "dependent": ["P"], "params": ["r", "K"], "equation": "D(P, t, 1) = r*P*(1 - P/K)"},
  {"id": "pendulum_full", "title": "Pendulum, large angle", "field": "mechanics", "kind": "ode", "independent": ["t"], "dependent": ["th"], "params": ["g", "l"], "equation": "D(th, t, 2) + (g/l)*sin(th) = 0"},
  {"id": "wave", "title": "Wave on a string", "field": "acoustics", "kind": "pde", "independent": ["t", "x"], "dependent": ["w"], "params": ["cw"], "equation": "D(w, t, 2) = cw**2*D(w, x, 2)"},
  {"id": "stefan", "title": "Stefan-Boltzmann radiation", "field": "thermal", "kind": "algebraic", "dependent": ["Pw", "T"], "params": ["sigma", "A"], "equation": "Pw = sigma*A*T**4"},
  {"id": "grav", "title": "Gravitational potential energy", "field": "astronomy", "kind": "algebraic", "dependent": ["Ug", "r"], "params": ["G", "M", "m"], "equation": "Ug = -G*M*m/r"},
  {"id": "boolean_or", "title": "Boolean OR", "field": "mathematics", "kind": "logic", "variables": ["x", "y"], "semantics": {}, "equation": "x | y"},
  {"id": "parity", "title": "Parity check (sum mod 2)", "field": "coding theory", "kind": "logic", "variables": ["p", "s"], "semantics": {"mod2sum": "Xor"}, "equation": "mod2sum(p, s)"},
  {"id": "freefall", "title": "Free fall without drag", "field": "mechanics", "kind": "ode", "independent": ["t"], "dependent": ["z"], "params": ["g"], "equation": "D(z, t, 2) = -g"}
]
