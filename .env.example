# Copy this file to .env (same folder) and paste your key from the "Relations" project in AI Studio.
GEMINI_API_KEY=paste-your-key-here

# Model names. Only change these if check_setup.py says a name was not found.
RELATIONS_EXTRACTOR_MODEL=gemma-4-31b-it
RELATIONS_FALLBACK_EXTRACTOR_MODEL=gemma-4-26b-a4b-it
RELATIONS_JUDGE_MODEL=gemini-3.5-flash-lite
RELATIONS_BACKUP_JUDGE_MODEL=gemini-3.1-flash-lite
